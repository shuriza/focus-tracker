{
  "manifest_version": 3,
  "name": "Fokus Kerja",
  "version": "1.1.0",
  "description": "Catat durasi browsing, pasang kuota harian, dan blokir situs saat batas habis.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Fokus Kerja",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "idle",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://focus-tracker-one-wheat.vercel.app/*",
    "https://wtpvftqiiwldcxlpzykl.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["blocked.css"],
      "run_at": "document_idle"
    }
  ]
}
